# Het wachtwoordbestand hoort NIET in de repo. In de repo staat
# config-voorbeeld.php; op de server komen de echte waarden uit de
# omgevingsvariabelen van Coolify.
config.php

# De uitrolhandleiding bevat het IP van de server en de SSH-stappen.
