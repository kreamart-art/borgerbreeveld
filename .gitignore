# nieuwe versie van de website overleven.
uploads/*
!uploads/.htaccess
!uploads/index.html
!uploads/thumbs/
uploads/thumbs/*
!uploads/thumbs/.htaccess
!uploads/thumbs/index.html

data/*
!data/.htaccess
!data/index.html

.DS_Store
